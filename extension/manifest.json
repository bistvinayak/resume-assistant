{
  "manifest_version": 3,
  "name": "Arjun Autofill",
  "version": "1.3.1",
  "description": "Fills job application forms from your Arjun profile and checks job fit + visa sponsorship.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://vinayakbist.com/*",
    "https://securetoken.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*",
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.icims.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://jobs.ashbyhq.com/*",
        "https://jobs.amazon.com/*",
        "https://hiring.amazon.com/*"
      ],
      "js": ["content-script.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://vinayakbist.com/*"
    ]
  }
}